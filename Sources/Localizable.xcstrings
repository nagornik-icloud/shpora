{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "Add File…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить файл…"
          }
        }
      }
    },
    "Add a file to start capturing notes": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте файл, чтобы начать записывать"
          }
        }
      }
    },
    "Can't read %@ — not saving over it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать %@ — поверх не сохраняю"
          }
        }
      }
    },
    "Changed in another app — your version saved as %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл изменили в другой программе — ваша версия сохранена как %@"
          }
        }
      }
    },
    "Close pane  ⌘W": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть панель  ⌘W"
          }
        }
      }
    },
    "Close second pane  ⌘W": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть вторую панель  ⌘W"
          }
        }
      }
    },
    "Close the second pane": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть вторую панель"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копировать"
          }
        }
      }
    },
    "Could not save: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить: %@"
          }
        }
      }
    },
    "Cut": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вырезать"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правка"
          }
        }
      }
    },
    "Everything you type is saved to the file automatically.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы печатаете, само сохраняется в файл."
          }
        }
      }
    },
    "File not found — it will be created again as you type": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не найден — он появится снова, когда начнёте печатать"
          }
        }
      }
    },
    "Files": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы"
          }
        }
      }
    },
    "Find…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найти…"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общее"
          }
        }
      }
    },
    "Go to the left / right pane": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейти в левую / правую панель"
          }
        }
      }
    },
    "Hide the window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрятать окно"
          }
        }
      }
    },
    "Insert a timestamp line": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый лид: метка времени, дальше имя"
          }
        }
      }
    },
    "Keys in the window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши в окне"
          }
        }
      }
    },
    "New File…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый файл…"
          }
        }
      }
    },
    "No file": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет файла"
          }
        }
      }
    },
    "No files yet": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлов пока нет"
          }
        }
      }
    },
    "Open / close the second pane": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть / закрыть вторую панель"
          }
        }
      }
    },
    "Open at login": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать при входе в систему"
          }
        }
      }
    },
    "Open the file in its default app": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть файл в программе по умолчанию"
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставить"
          }
        }
      }
    },
    "Quit Shpora": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти из Shpora"
          }
        }
      }
    },
    "Redo": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить"
          }
        }
      }
    },
    "Remove from list (the file stays on disk)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать из списка (файл останется на диске)"
          }
        }
      }
    },
    "Second pane  ⌘D": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вторая панель  ⌘D"
          }
        }
      }
    },
    "Select All": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделить всё"
          }
        }
      }
