    "Settings  ⌘,": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки  ⌘,"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки…"
          }
        }
      }
    },
    "Shortcut": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горячая клавиша"
          }
        }
      }
    },
    "Show / hide Shpora": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать / спрятать Shpora"
          }
        }
      }
    },
    "Show Shpora": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать Shpora"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать в Finder"
          }
        }
      }
    },
    "Shpora Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки Shpora"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить"
          }
        }
      }
    },
    "Shortcuts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горячие клавиши"
          }
        }
      }
    },
    "Open settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки"
          }
        }
      }
    },
    "The first one works everywhere. The others work only while the Shpora window is in focus.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая работает везде. Остальные — только когда курсор в окне Shpora."
          }
        }
      }
    },
    "Look": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вид"
          }
        }
      }
    },
    "Background": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон"
          }
        }
      }
    },
    "Glass": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стекло"
          }
        }
      }
    },
    "Clear glass": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прозрачное стекло"
          }
        }
      }
    },
    "Frosted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Матовое"
          }
        }
      }
    },
    "Solid": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплошной"
          }
        }
      }
    },
    "⌘T — new lead · ⌘F — search": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘T — новый лид · ⌘F — поиск"
          }
        }
      }
    },
    "Text size": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер текста"
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "Show icon in the Dock": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать значок в Dock"
          }
        }
      }
    },
    "Show icon in the menu bar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать значок в строке меню"
          }
        }
      }
    },
    "With both icons off, open Shpora again from Applications or Spotlight to bring the window back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если оба значка выключены, откройте Shpora ещё раз из «Программ» или Spotlight — окно появится."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия"
          }
        }
      }
    },
    "Updates": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять обновления автоматически"
          }
        }
      }
    },
    "Check Now": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить сейчас"
          }
        }
      }
    },
    "Updates will work once there is a place to publish new versions.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления заработают, когда появится место, где публикуются новые версии."
          }
        }
      }
